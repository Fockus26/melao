# Melao — variables de entorno. Copiar a .env.local y llenar. Nunca valores reales aquí.

# Supabase (Project Settings → API). La URL completa: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor y scripts (seed, admin). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# URL pública del sitio (metadata, callbacks de auth). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# QA → .env.test.local (no aquí). Una pareja por rol; valores inventados: `bun run qa:local`
# las crea en la base local en cada corrida (alumno con suscripción activa). `smoke:ef` usa la
# pareja del alumno contra el proyecto real: ahí la cuenta la crea César.
EMAIL_TEST=
PASSWORD_TEST=
ADMIN_EMAIL_TEST=
ADMIN_PASSWORD_TEST=

# Modo mantenimiento (D111): 1 = todo el sitio responde 503 con la pantalla de mantenimiento.
# Hora estimada de vuelta, ISO 8601 (opcional): da Retry-After y "Volvemos aproximadamente".
MAINTENANCE_MODE=
MAINTENANCE_UNTIL=
